{
  "name": "work-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "sim": "tsx sim/run.ts --orders 1000 --seed 1 --mode flag && tsx sim/run.ts --orders 1000 --seed 2 --mode hold && tsx sim/named.ts",
    "lint:generic": "node scripts/lint-generic.mjs",
    "lint": "npm run build && npm run lint:generic",
    "snapin:test": "node --import tsx --test snap-in/test/*.test.ts",
    "snapin:build": "tsc --noEmit -p snap-in && node snap-in/scripts/build.mjs",
    "snapin:pack": "sh snap-in/scripts/pack.sh"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
